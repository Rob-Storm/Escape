<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>True</AllowUnsafeBlocks>
    <Title>Escape</Title>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="AStarLite" Version="1.3.0" />
    <PackageReference Include="NativeFileDialogSharp" Version="0.5.0" />
    <PackageReference Include="RayGUI-cs" Version="2.0.5" />
    <PackageReference Include="Raylib-cs" Version="8.0.0" />
    <PackageReference Include="rlImgui-cs" Version="3.2.0" />
  </ItemGroup>

  <ItemGroup>
    <None Update="Assets\**\*">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Assets\Maps\" />
  </ItemGroup>

  <Target Name="CreateEditorBat" AfterTargets="Build">
    <WriteLinesToFile File="$(TargetDir)Editor.bat" Lines="&quot;$(AssemblyName).exe&quot; --editor" Overwrite="true" />
  </Target>

</Project>
